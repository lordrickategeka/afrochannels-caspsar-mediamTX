# Template for the .env that sits next to docker-compose.yml ON THE INGEST VM.
# Copy to ".env" there and fill in. Never commit the filled-in copy.

# Must match authInternalUsers[syscg-publisher].pass in that VM's mediamtx.yml.
# deploy.sh substitutes this value into mediamtx.yml on every deploy, so the
# committed copy can keep its CHANGE_ME placeholder.
# Keep it URL-safe (alphanumeric): it is placed in an RTMP query string.
MEDIAMTX_PUBLISH_PASSWORD=

# Full ffmpeg input URL for the always-on feed. Any format ffmpeg's -i accepts
# (udp://, srt://, rtmp://, rtsp://, http://). For UDP multicast, "localaddr"
# must be this VM's own IP on the interface carrying the feed:
#
#   MULTICAST_SOURCE=udp://239.1.2.3:5000?localaddr=192.168.31.32&overrun_nonfatal=1&fifo_size=5000000&buffer_size=67108864
#
# Quote the value: it contains "&", and this file is sourced by deploy.sh as
# well as read by compose.
# Leave empty to skip the static ingest entirely (the dashboard's own per-stream
# containers are unaffected).
MULTICAST_SOURCE=""

# Which program (TV service) inside that transport stream to publish. One
# multicast group carries several. List what a group contains with:
#   ffprobe -show_programs -of compact=p=0 "<the MULTICAST_SOURCE url>"
# and read the "tag:service_name" of each program_id.
MULTICAST_PROGRAM=1

# MediaMTX path the feed is published to; the HLS URL becomes
# https://<domain>/live/<this>/index.m3u8
MULTICAST_PATH=multicast_stream

# Public hostname for the HLS links. Must already resolve to this site's public
# IP before Caddy starts, or certificate issuance fails. Leave empty to run
# without the public HTTPS edge (LAN access on :8888 only).
STREAM_DOMAIN=
