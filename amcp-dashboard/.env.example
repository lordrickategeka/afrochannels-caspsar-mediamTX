PORT=3005

CASPAR_HOST=127.0.0.1
CASPAR_PORT=5250

# SQLite - a single self-contained file at db/database.sqlite, created
# automatically on first run. No separate database server needed.

# Session cookie signing secret - required, no default.
SESSION_SECRET=change-me

# Cloud MediaMTX VM (UDP -> HLS ingest) - see vm-control.js.
# Only required if you use the "Cloud Streams" feature in the dashboard.
VM_HOST=<ingest VM IP or hostname>
VM_SSH_PORT=22
VM_SSH_USER=
# Path to a private key file for SSH key-based auth (recommended). Leave
# unset and set VM_SSH_PASSWORD instead if you're using password auth.
# NOTE: if VM_SSH_KEY_PATH is non-empty it is used INSTEAD of the password,
# never as a fallback - a stale path here makes every connection fail with
# "All configured authentication methods failed". Leave it empty for
# password auth.
VM_SSH_KEY_PATH=
VM_SSH_PASSWORD=

# Must match the "publish" user in the VM's mediamtx.yml authInternalUsers.
MEDIAMTX_PUBLISH_USER=syscg-publisher
MEDIAMTX_PUBLISH_PASSWORD=

# Base URL other systems will use to pull HLS - the VM's MediaMTX HLS listener.
MEDIAMTX_HLS_BASE=https://<public hostname>   # or http://<vm-ip>:8888 on the LAN
